# Copy to .env on your server. Never package this file with real secrets.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/mailboxes.sqlite
MAIL_DOMAIN=inbox.example.com
MAILBOX_TTL_MINUTES=60
# Generate a random invitation secret, at least 24 characters.
ENROLLMENT_CODE=replace-with-a-long-random-invitation-code
# From Mailgun's HTTP Webhook Signing Key setting; NOT its API key.
MAILGUN_WEBHOOK_SIGNING_KEY=replace-with-your-http-webhook-signing-key
